# Copy to .env and fill in as needed. NEVER commit real keys.
# Local servers (LM Studio, llama-server, vLLM) usually need no API key.

# --- role: sol (strong reasoning) ---
SOL_BASE_URL=http://127.0.0.1:1234/v1
SOL_MODEL=sol
# SOL_API_KEY=

# --- role: terra (validation / quality) ---
TERRA_BASE_URL=http://127.0.0.1:1234/v1
TERRA_MODEL=terra
# TERRA_API_KEY=

# --- role: luna (high-volume enrichment / simulation) ---
LUNA_BASE_URL=http://127.0.0.1:1234/v1
LUNA_MODEL=luna
# LUNA_API_KEY=
