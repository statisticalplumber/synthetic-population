{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "scenario.schema.json",
  "$defs": {
    "Scenario": {
      "additionalProperties": false,
      "description": "A behavioral scenario presented to personas during simulation.",
      "properties": {
        "scenario_id": {
          "title": "Scenario Id",
          "type": "string"
        },
        "version": {
          "default": "v1",
          "title": "Version",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Options",
          "type": "array"
        },
        "context": {
          "additionalProperties": true,
          "title": "Context",
          "type": "object"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        }
      },
      "required": [
        "scenario_id",
        "category",
        "question",
        "options"
      ],
      "title": "Scenario",
      "type": "object"
    }
  }
}
